# Copy to .env and fill in. .env is gitignored; this file is committed.
# On a host (Vercel, Netlify…) set the same variables in its dashboard.
#
# Everything here ends up in the public HTML/JS — never put secrets in it.
# Wrap a word in *asterisks* to set it in the italic serif accent.

# --- Who you are -----------------------------------------------------------
VITE_NAME="Your Name"
VITE_ROLE="Creative Developer"
# Search/social description. Defaults to "<name> — <role>. …" when empty.
VITE_DESCRIPTION=""
# The big statement under the portrait.
VITE_INTRO="I turn bold designs into fast, tactile websites — motion, WebGL and front-end engineering for studios, agencies and brands that want the web to feel alive."

# --- Where you are ---------------------------------------------------------
# Natural Earth country name: drives the particle map and where the globe turns.
VITE_COUNTRY="Philippines"
VITE_LOCATION_HEADING="Based in the *Philippines*"
VITE_LOCATION_NOTE="UTC+8 · open to collaborations worldwide."

# --- Contact (leave a link empty to hide it) -------------------------------
VITE_EMAIL="hello@yourname.com"
VITE_LINKEDIN_URL=""
VITE_GITHUB_URL=""
VITE_INSTAGRAM_URL=""
VITE_DRIBBBLE_URL=""

# --- Portrait --------------------------------------------------------------
# An image in /public, e.g. "/portrait.png" (encode spaces as %20).
# Empty = the placeholder bust.
VITE_PORTRAIT_SRC=""
# "auto" works it out: "alpha" (transparent cut-out), "light" (plain light
# background, cut out automatically) or "luma" (subject lit against black).
VITE_PORTRAIT_MODE="auto"
# Optional greyscale depth map with the same framing (white = near).
VITE_PORTRAIT_DEPTH_SRC=""

# --- Skills ----------------------------------------------------------------
# Comma-separated; listed as text in the Skills section.
VITE_SKILLS="React, TypeScript, Three.js, WebGL, GSAP, Webflow, Figma, Node.js"

# --- Selected work ---------------------------------------------------------
# JSON array, one tile per project. "url" and "image" are optional; "image" is
# a file in /public (e.g. "/works/northwind.jpg", ideally 16:10) shown on the
# tile — without one the tile gets a bundled placeholder image.
# Keep this block last — it spans several lines.
VITE_PROJECTS='[
  { "title": "Northwind *Studio*", "meta": "Brand site · WebGL · 2026", "url": "https://example.com" },
  { "title": "Lumen *Records*", "meta": "E-commerce · Motion · 2025" },
  { "title": "Atlas *Outdoor*", "meta": "Campaign · Three.js · 2025" },
  { "title": "Kinfolk *Café*", "meta": "Webflow · Interaction · 2024" }
]'
